# Copy to .env and fill in the keys you actually have.
# The server reads these from the process environment; they are never stored
# in ChatServer.conf or committed to the repository.
#
#   source .env   # or: export $(grep -v '^#' .env | xargs)

# DeepSeek — https://platform.deepseek.com
DEEPSEEK_API_KEY=

# OpenAI / ChatGPT-compatible endpoint.
# When this is unset, ChatGPTProvider falls back to DEEPSEEK_API_KEY.
CHATGPT_API_KEY=
OPENAI_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Ollama needs no key; point the server at it via --ollama_endpoint
# in apps/chat_server/ChatServer.conf (default http://127.0.0.1:11434).
